<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.overdrive.shared/Editor/Resources/UI/Overdrive_USS_ProjectSettings.uss?fileID=7433441132597879392&amp;guid=751eb7d26107a744695eb099be9bab25&amp;type=3#Overdrive_USS_ProjectSettings" />
    <Style src="project://database/Packages/com.overdrive.shared/Editor/Resources/UI/Overdrive_ClassStyles.uss?fileID=7433441132597879392&amp;guid=6a6746da0d952c043ac60d2621ac3d5f&amp;type=3#Overdrive_ClassStyles" />
    <Style src="project://database/Packages/com.overdrive.shared/Editor/Resources/UI/Overdrive_GeneralStyles.uss?fileID=7433441132597879392&amp;guid=975ea3c222eca5749a8e2c9f7b65dcbb&amp;type=3#Overdrive_GeneralStyles" />
    <ui:VisualElement class="overdrive-styling">
        <ui:Label text="Overdrive Toolset" class="no-really-though h1" style="margin-left: 8px; margin-top: 6px; margin-bottom: 4px; color: rgb(111, 111, 111);" />
        <ui:ScrollView class="overdrive-styling column column-spaced" style="padding-right: 0; padding-bottom: 0; padding-left: 0; padding-top: 0;">
            <ui:VisualElement class="panel-base" style="flex-direction: row;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/Pins_Icon&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="Pins" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Quick access to your frequently used items and variables" parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-Pins" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-base" style="flex-direction: row; margin-top: 0;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/SceneBlocks_Icon&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="Scene Blocks" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Seamless collaboration solution for Unity scenes" parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-SceneBlocks" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-base" style="flex-direction: row; margin-top: 0;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/Multiverse_Icon_Cubes&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="Multiverse" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Edit multiple scenes, prefabs, and other assets simultaneously" parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-Multiverse" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-base" style="flex-direction: row; margin-top: 0;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/Collections_Icon&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="Collections" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Selecting and editing a few things often? Add them to a Collection." parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-Collections" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-base" style="flex-direction: row; margin-top: 0;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/check-done-list-todo&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="Todo" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Track your todo items and link them to scene objects and assets" parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-Todo" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-base" style="flex-direction: row; margin-top: 0;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/ProBuilderPlus_Icon&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="ProBuilder Plus" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Advanced 3D modeling and level design tools for Unity" parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-ProBuilderPlus" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-base" style="flex-direction: row; margin-top: 0;">
                <ui:VisualElement name="Tool-Icon" style="background-image: resource(&apos;icons/edit-tools&apos;);" />
                <ui:VisualElement class="info-block" style="flex-grow: 1;">
                    <ui:Label tabindex="-1" text="EasyEdit" parse-escape-sequences="true" display-tooltip-when-elided="true" class="h3 no-really-though" />
                    <ui:Label tabindex="-1" text="Enhanced transformation tools for precise object editing" parse-escape-sequences="true" display-tooltip-when-elided="true" class="package-info-text" />
                    <ui:Button text="More Info" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Btn-Web-EasyEdit" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
